# ---------- Сборки и отладка ----------
*.apk
*.aab
*.app
*.unitypackage
sysinfo.txt
crashlytics-build.properties

# ---------- Asset Store ----------
/[Aa]ssets/AssetStoreTools*

# ---------- Системные файлы ----------
.DS_Store
Thumbs.db

# ---------- Секреты: никогда не коммитить ----------
# SSH-ключи
Antracites_git
Antracites_git.pub
id_rsa*
id_ed25519*
*.pem
# Ключи подписи Android
*.keystore
*.jks