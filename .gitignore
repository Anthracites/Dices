# Положи этот файл в корень проекта (рядом с папками Assets, Packages, ProjectSettings)

# ---------- Unity: генерируемые папки ----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
ExportedObj/

# ---------- IDE ----------
.vs/
.idea/
.vscode/
.consulo/
.gradle/
/[Aa]ssets/Plugins/Editor/JetBrains*

